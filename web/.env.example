# Copy to .env.local and fill in from Firebase console > Project settings.
# Vite only exposes variables prefixed with VITE_ to the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the SDK at the local emulator suite during development.
VITE_USE_FIREBASE_EMULATORS=false

# Optional — only needed for the one-click "Connect with Facebook" WhatsApp
# signup on the Settings page. From the Meta App Dashboard: the App ID is on
# the app's Basic Settings page; the Config ID comes from setting up a
# "WhatsApp Business Embedded Signup" login flow under Facebook Login for
# Business. Leave both blank to fall back to the manual connect form — it
# needs no Meta App configuration beyond what functions/README already asks for.
VITE_META_APP_ID=
VITE_META_CONFIG_ID=

# Optional — enables Sentry error reporting (utils/monitoring.ts). Leave
# blank to disable entirely; unhandled errors still log to the console either way.
VITE_SENTRY_DSN=

# Optional — enables Firebase Analytics page-view tracking (utils/analyticsTracking.ts).
# From Firebase console > Project settings > this web app > SDK setup — only
# present once you've enabled Analytics for the project (it's opt-in per project).
VITE_FIREBASE_MEASUREMENT_ID=
