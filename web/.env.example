# Copy to .env.local and fill in from Firebase console > Project settings.
# Vite only exposes variables prefixed with VITE_ to the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the SDK at the local emulator suite during development.
VITE_USE_FIREBASE_EMULATORS=false

# Required for the WhatsApp connect page to work at all — a one-time,
# platform-owner setup task, not something each merchant configures. See
# PLATFORM_SETUP.md for how to get all three. Leave blank during early
# development and WhatsAppPage shows a calm "not configured yet" state
# instead of a broken button.
VITE_META_APP_ID=
VITE_META_CONFIGURATION_ID=
VITE_WHATSAPP_WORKER_URL=

# Optional — enables Sentry error reporting (utils/monitoring.ts). Leave
# blank to disable entirely; unhandled errors still log to the console either way.
VITE_SENTRY_DSN=

# Optional — enables Firebase Analytics page-view tracking (utils/analyticsTracking.ts).
# From Firebase console > Project settings > this web app > SDK setup — only
# present once you've enabled Analytics for the project (it's opt-in per project).
VITE_FIREBASE_MEASUREMENT_ID=
